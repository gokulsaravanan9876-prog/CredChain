# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Database ---
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://credchain:credchain@localhost:5432/credchain

# --- Auth / JWT (used starting Phase 3) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme-generate-a-real-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Sharing (Phase 6) ---
FRONTEND_BASE_URL=http://localhost:5173

# --- AI (Phase 7) ---
# Leave AI_ENABLED=false (or AI_API_KEY empty) to run in fallback/demo mode —
# every AI endpoint still works, using a clearly-labeled deterministic
# analyzer instead of a real LLM call. See app/services/ai/ai_service.py.
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5

# --- Document storage ---
STORAGE_PATH=./storage
MAX_DOCUMENT_SIZE_BYTES=10485760

# --- Institution signing keys ---
# Directory holding one PEM private key per institution (<institution_id>.pem).
# DEV KEY MANAGEMENT: plain files on disk, git-ignored, server-side only —
# see app/services/signing_service.py for the documented production tradeoff.
# Never commit real key material.
KEYS_PATH=./keys

# --- Blockchain credential-hash anchoring (Phase 9A/9B) ---
# Leave BLOCKCHAIN_ENABLED=false to run with no RPC/wallet configured — the
# anchor endpoint fails cleanly with blockchain_status=FAILED instead of
# attempting a network call. See blockchain/README.md for how to get a
# Polygon Amoy RPC URL and testnet funds, and how to deploy the contract.
#
# BLOCKCHAIN_PRIVATE_KEY is a BACKEND SERVICE wallet key — NOT the
# institution's Ed25519 signing key, NOT a student's key, NOT a company's
# key. It only ever needs a small amount of testnet gas, never real funds.
# Never commit a real value here. In production this should come from a
# KMS/HSM or a managed wallet service, not a plaintext .env file.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_NETWORK_NAME=polygon-amoy
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
